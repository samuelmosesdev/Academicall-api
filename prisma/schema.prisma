generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  alphaAgent
  agent
  courseRep
  newsAgent
  user
  /// Prospective student seeking admission (UTME / Post-UTME candidate)
  aspirant
}

enum Plan {
  free
  pro
  annual
}

enum UserStatus {
  active
  suspended
  deleted
}

enum NotificationType {
  general
  payment_claim
  class_event
  announcement
  system
  new_student
  lecture_update
  announcement_published
  house
  news
  test
  moderation
  security
}

model User {
  id                         String       @id @default(uuid())
  firebaseUid                String?      @unique // legacy/unused — hybrid Firebase auth bridge was removed
  googleUid                  String? // for direct Google Identity Services auth; email is the unique account key
  email                      String       @unique
  passwordHash               String? // null when using only Firebase
  passwordChangedAt          DateTime?
  mustChangePassword         Boolean      @default(false)
  passwordResetHash          String?
  passwordResetExpiresAt     DateTime?
  name                       String?
  role                       Role         @default(user)
  plan                       Plan         @default(free)
  status                     UserStatus   @default(active)
  uniqueId                   String?      @unique // e.g. UAR-24-8831
  emailVerified              Boolean      @default(false)
  emailVerificationHash      String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?
  emailVerificationAttempts  Int          @default(0)
  profileComplete            Boolean      @default(false)
  department                 String?
  faculty                    String?
  program                    String?
  level                      String?
  institutionId              String?
  institution                Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  facultyId                  String?
  departmentId               String?
  programId                  String?
  matricNumber               String?
  phone                      String?
  bio                        String?
  interests                  String?
  dob                        String?
  gender                     String?
  nickname                   String?
  showDepartment             Boolean      @default(true)
  showPhone                  Boolean      @default(false)
  allowAnonymousComments     Boolean      @default(false)
  photoUrl                   String?
  avatarUrl                  String?
  settings                   Json?
  fcmToken                   String?
  deviceToken                String?
  fcmTokens                  Json?
  coursesEnrolledCount       Int          @default(0)
  questionsPracticedCount    Int          @default(0)
  studyStreakDays            Int          @default(0)
  materialsOpenedCount       Int          @default(0)
  lastActiveDate             String?
  lastActiveAt               DateTime?
  courseRepMeta              Json?
  assignedBy                 String?
  assignedAt                 DateTime?
  agentDomain                String?
  createdByAdmin             Boolean      @default(false)
  createdByUid               String?
  canImportAI                Boolean      @default(true)
  autoPublish                Boolean      @default(false)
  customCourses              Json?
  /// Add-on duties any user can hold alongside their role: "news", "secretary"
  staffTags                  String[]     @default([])
  /// Admin-chosen capability list; null = the defaults for the role and tags
  permissions                Json?
  /// Tokens issued before this moment are rejected (force sign-out)
  sessionsRevokedAt          DateTime?
  /// Aspirant extras: { utmeYear, utmeScore, stateOfOrigin, jambRegNo }
  aspirantMeta               Json?
  /// Newsroom standing, set by a Chief News Agent: active | restricted (needs approval) | suspended
  newsStatus                 String       @default("active")
  newsStatusReason           String?
  newsStatusAt               DateTime?
  /// Get alerts for stories publishers aim at people like you
  newsAlerts                 Boolean      @default(true)
  /// Can't post, comment or reply until this moment (set from the moderation queue)
  mutedUntil                 DateTime?
  /// { profileVisibility: everyone|classmates|nobody, showCourses: bool }
  privacy                    Json?
  /// Two-step sign-in: "email" | "totp" | null (off)
  twoFactorMethod            String?
  /// TOTP secret, AES-GCM encrypted
  twoFactorSecret            String?
  twoFactorEnabledAt         DateTime?
  twoFactorBackupHashes      String[]     @default([])
  /// Sees features an admin has limited to beta testers
  betaTester                 Boolean      @default(false)
  /// { types: { [type]: false }, quietStart: "22:00", quietEnd: "06:00", push: bool }
  notificationPrefs          Json?
  /// UTME goals: exam date (YYYY-MM-DD) and questions per day
  utmeExamDate               String?
  utmeDailyTarget            Int?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  // Relations
  documents             Document[]             @relation("UploadedBy")
  enrollments           Enrollment[]
  notifications         Notification[]         @relation("UserNotifications")
  createdNotifications  Notification[]         @relation("CreatedBy")
  activityLogs          ActivityLog[]
  paymentClaims         PaymentClaim[]
  timetableEvents       TimetableEvent[]
  materialSaves         MaterialSave[]
  materialFolders       MaterialFolder[]
  materialSharesSent    MaterialShare[]        @relation("MaterialShareSender")
  materialSharesInbox   MaterialShare[]        @relation("MaterialShareRecipient")
  requests              Request[]              @relation("Requester")
  profileChangeRequests ProfileChangeRequest[]
  subscriptions         Subscription[]
  departmentMemberships DepartmentMembership[] @relation("DeptMemberships")
  studyGroupsCreated    StudyGroup[]           @relation("StudyGroupCreator")
  studyGroupMemberships StudyGroupMember[]     @relation("StudyGroupMemberUser")
  studyGroupMessages    StudyGroupMessage[]    @relation("StudyGroupMessageSender")
  vault                 VaultAccount?
  vaultFolders          VaultFolder[]
  vaultFiles            VaultFile[]
  newsPosts             NewsPost[]             @relation("NewsAuthor")
  newsComments          NewsComment[]
  newsReactions         NewsReaction[]
  secretariatRecords    SecretariatRecord[]    @relation("SecretariatAuthor")
  aspirations           Aspiration[]
  houseMemberships      AspirantHouseMember[]
  houseLeads            AspirantHouseLeader[]
  houseThreads          HouseThread[]          @relation("HouseThreadAuthor")
  houseReplies          HouseReply[]           @relation("HouseReplyAuthor")
  newsSubscriptions     NewsSubscription[]
  utmeAttempts          UtmeAttempt[]
  utmePatches           UtmeQuestionPatch[] @relation("UtmePatchEditor")
  sessions              UserSession[]
  deviceTokens          DeviceToken[]
  academicResults       AcademicResult[]
  testAttempts          GeneralTestAttempt[]
  blocksMade            UserBlock[]            @relation("Blocker")
  blocksReceived        UserBlock[]            @relation("Blocked")
  restrictions          UserRestriction[]

  @@index([role])
  @@index([department])
  @@index([institutionId])
  @@index([plan])
  @@map("users")
}

model Document {
  id                  String    @id @default(uuid())
  institutionId       String?
  title               String
  description         String?
  fileUrl             String?
  thumbnailUrl        String?
  fileName            String?
  fileSize            Int?
  tags                Json?
  faculty             String?
  department          String?
  level               String?
  source              String? // "courseRep" | "admin" | "agent"
  status              String    @default("pending")
  approvedById        String?
  approvedAt          DateTime?
  uploadedById        String
  uploadedBy          User      @relation("UploadedBy", fields: [uploadedById], references: [id])
  courseId            String?
  course              Course?   @relation(fields: [courseId], references: [id])
  openCount           Int       @default(0)
  questionCount       Int       @default(0)
  easyQuestionCount   Int       @default(0)
  mediumQuestionCount Int       @default(0)
  hardQuestionCount   Int       @default(0)
  reactions           Json? // { like: number, ... }
  deletedAt           DateTime? // soft delete: recoverable from the Document Center
  deletedById         String?
  folderId            String? // personal uploads: the student's own MaterialFolder (null = top level)
  folder              MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([uploadedById])
  @@index([folderId])
  @@index([deletedAt])
  @@index([courseId])
  @@index([status])
  @@index([institutionId, department, level])
  @@map("documents")
}

model Course {
  id           String    @id @default(uuid())
  title        String
  code         String?
  faculty      String?
  department   String?
  level        String?
  semester     String?
  description  String?
  thumbnailUrl String?
  category     String?
  source       String?
  published    Boolean   @default(true)
  approvedBy   String?
  requestedBy  String?
  /// Credit units from the national curriculum, when known
  units        Int?
  /// "CODE|title" (upper-cased) for courses imported from the national curricula; null for hand-made ones
  catalogKey   String?   @unique
  /// Set when an admin retires a course; it stays on existing student lists but stops being suggested
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents         Document[]
  enrollments       Enrollment[]
  curriculumEntries CurriculumCourse[]
  departmentLinks   DepartmentCourse[]

  @@index([code])
  @@map("courses")
}

model Enrollment {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?   @relation(fields: [courseId], references: [id])
  courseTitle    String?
  /// Course code for custom (non-catalogue) entries, upper-cased; catalogue entries read it from the course
  courseCode     String?
  /// catalogue | custom | ai | courseRep | legacy
  source         String?   @default("catalogue")
  topicLabel     String?
  progressPct    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, courseId])
  @@unique([userId, courseCode])
  @@index([userId])
  @@map("enrollments")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?            @relation("CreatedBy", fields: [createdById], references: [id])
  type        NotificationType @default(general)
  title       String
  body        String?
  data        Json?
  readByUser  Boolean          @default(false)
  readByAdmin Boolean          @default(false)
  readAt      DateTime?
  archived    Boolean          @default(false)
  archivedAt  DateTime?
  deleted     Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())

  /// Set once the push dispatcher has handled it (sent, skipped or no device)
  pushedAt     DateTime?

  @@index([pushedAt, createdAt])
  @@index([userId, readByUser])
  @@index([userId, archived])
  @@index([readByAdmin])
  @@map("notifications")
}

model DepartmentMembership {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation("DeptMemberships", fields: [userId], references: [id], onDelete: Cascade)
  department          String
  faculty             String?
  level               String?
  status              String    @default("pending")
  requestedAt         DateTime  @default(now())
  admittedAt          DateTime?
  admittedById        String?
  withdrawRequestedAt DateTime?
  withdrawReason      String?
  withdrawStatus      String?
  withdrawReviewedAt  DateTime?
  withdrawReviewedBy  String?
  reviewReason        String?
  reviewedById        String?
  reviewedAt          DateTime?
  institutionId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, institutionId, department])
  @@index([institutionId, department])
  @@index([department, status])
  @@index([userId])
  @@map("department_memberships")
}

model AnnouncementRead {
  id             String    @id @default(uuid())
  announcementId String?
  userId         String?
  readAt         DateTime?
  meta           Json?
  createdAt      DateTime  @default(now())

  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reads")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String?
  action    String
  status    String? // success | error | pending
  reference String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

model PaymentClaim {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String // pending | clicked_checkout | awaiting_review | activated | rejected
  plan      String?
  reference String?
  amount    Int?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payment_claims")
}

model Payment {
  id        String   @id @default(uuid())
  userId    String?
  reference String?  @unique
  status    String?
  plan      String?
  amount    Int?
  currency  String?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model PaymentOrphan {
  id        String   @id @default(uuid())
  reference String?
  reason    String?
  data      Json
  createdAt DateTime @default(now())

  @@index([reference])
  @@map("payment_orphans")
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    String?
  plan      String?
  provider  String?
  reference String?
  startsAt  DateTime?
  endsAt    DateTime?
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, status])
  @@index([status])
  @@map("subscriptions")
}

model Agent {
  id        String   @id @default(uuid())
  userId    String?
  name      String?
  email     String?
  status    String?
  domain    String?
  meta      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("agents")
}

model TimetableEvent {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startAt         DateTime?
  endAt           DateTime?
  location        String?
  courseId        String?
  courseCode      String?
  dayOfWeek       Int?
  startTime       String?
  endTime         String?
  reminderMinutes Int?
  reminderEnabled Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@map("timetable_events")
}

model ClassEvent {
  id            String    @id @default(uuid())
  title         String
  courseCode    String?
  venue         String?
  notes         String?
  startsAt      DateTime
  endsAt        DateTime?
  faculty       String?
  department    String?
  level         String?
  createdBy     String
  createdByName String?
  institutionId String?
  comments      Json?
  reactions     Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([department, level])
  @@index([institutionId, department])
  @@index([createdBy])
  @@map("class_events")
}

model MaterialSave {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String?
  title      String?
  url        String?
  meta       Json?
  folderId   String? // moved into one of the student's own folders (null = grouped by course)
  folder     MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([folderId])
  @@map("material_saves")
}

/// A student's own folder in My materials. Folders can sit inside folders (max 3 deep).
model MaterialFolder {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MaterialFolder?  @relation("MaterialFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MaterialFolder[] @relation("MaterialFolderTree")
  name      String
  color     String           @default("violet")
  position  Int              @default(0)
  documents Document[]
  saves     MaterialSave[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, parentId])
  @@map("material_folders")
}

/// A file or folder from My materials sent to another user (found by their Unique ID).
/// The recipient accepts (a copy lands in their own library) or declines.
/// Item ids are soft references: the sender may delete the original before it is accepted.
model MaterialShare {
  id             String    @id @default(uuid())
  senderId       String
  sender         User      @relation("MaterialShareSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User      @relation("MaterialShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind           String // "file" | "folder"
  itemType       String // "upload" | "save" | "folder"
  itemId         String
  title          String
  /// Folder shares: how many files and folders were inside when sent
  fileCount      Int       @default(0)
  folderCount    Int       @default(0)
  comment        String?
  status         String    @default("pending") // pending | accepted | declined | cancelled
  /// Where the copy landed in the recipient's library (folder shares)
  copiedFolderId String?
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([recipientId, status])
  @@index([senderId, createdAt])
  @@map("material_shares")
}

model FeedPost {
  id            String   @id @default(uuid())
  kind          String
  title         String?
  body          String?
  courseCode    String?
  faculty       String?
  department    String?
  level         String?
  pinned        Boolean  @default(false)
  authorId      String
  authorName    String?
  authorRole    String?
  authorPhoto   String?
  comments      Json?
  reactions     Json?
  institutionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind, department, level])
  @@index([institutionId, kind, department])
  @@map("feed_posts")
}

model Request {
  id             String    @id @default(uuid())
  requesterUid   String
  requester      User      @relation("Requester", fields: [requesterUid], references: [id])
  type           String?
  title          String?
  body           String?
  requesterName  String?
  requesterEmail String?
  requesterRole  String?
  field          String?
  fieldLabel     String?
  requestedValue String?
  reason         String?
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewedByName String?
  reviewNote     String?
  status         String    @default("pending") // pending | approved | rejected
  meta           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([requesterUid])
  @@index([status])
  @@map("requests")
}

model ProfileChangeRequest {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName       String?
  userEmail      String?
  uniqueId       String?
  field          String
  fieldLabel     String?
  currentValue   String?
  requestedValue String
  reason         String?
  status         String    @default("pending")
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewedByName String?
  adminNote      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("profile_change_requests")
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  body       String?
  createdBy  String?
  published  Boolean  @default(true)
  audience   String   @default("all")
  faculty    String?
  department String?
  level      String?
  courseCode String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("announcements")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model CbtQuestion {
  id                String   @id @default(uuid())
  courseId          String?
  documentId        String?
  materialId        String?
  courseCode        String?
  courseTitle       String?
  topic             String?
  faculty           String?
  department        String?
  level             String?
  questionText      String
  options           Json
  correctIndex      Int
  explanation       String?
  difficulty        String   @default("medium")
  marks             Int      @default(1)
  referenceCode     String?
  hintEnabled       Boolean  @default(true)
  source            String?
  generatedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([courseCode])
  @@index([documentId])
  @@index([materialId])
  @@index([generatedByUserId])
  @@map("cbt_questions")
}

model GeneratedQuiz {
  id            String    @id @default(uuid())
  userId        String
  materialId    String?
  materialTitle String?
  courseCode    String?
  courseTitle   String?
  difficulty    String?
  questionCount Int       @default(0)
  questionIds   Json
  sectionNote   String?
  status        String    @default("ready")
  score         Int?
  answers       Json?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([materialId])
  @@index([userId, createdAt])
  @@map("generated_quizzes")
}

model StaffChatMessage {
  id                 String    @id @default(uuid())
  authorId           String
  authorUid          String?
  authorName         String?
  authorRole         String?
  authorPhoto        String?
  authorPlan         String?
  authorSubscription String?
  type               String    @default("text")
  text               String?
  mediaUrl           String?
  mediaWidth         Int?
  mediaHeight        Int?
  mediaDuration      Int?
  reactions          Json?
  replyToId          String?
  replyTo            Json?
  clientAt           String?
  meeting            Json?
  edited             Boolean   @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  deletedByName      String?
  deletedByRole      String?
  editedAt           DateTime?
  deleted            Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([createdAt])
  @@map("staff_chat_messages")
}

// ─── Academic structure: Institution → Faculty → Department → Program ────────

model Institution {
  id           String   @id
  name         String // official name, exactly as published (e.g. JAMB IBASS)
  displayName  String?
  abbreviation String?
  type         String? // Degree | NCE | ND ...
  category     String? // e.g. FEDERAL UNIVERSITIES
  ownership    String? // Federal | State | Private
  state        String?
  source       String   @default("ibass")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faculties   Faculty[]
  users       User[]
  studyGroups StudyGroup[]
  aspirations Aspiration[]
  house       AspirantHouse?

  @@unique([name, abbreviation])
  @@index([name])
  @@index([state])
  @@map("institutions")
}

model Faculty {
  id            String      @id
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  kind          String      @default("faculty") // faculty | ibass_group | programme_group | unassigned
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  departments AcademicDepartment[]

  @@unique([institutionId, name])
  @@map("faculties")
}

model AcademicDepartment {
  id        String   @id
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  name      String
  derived   Boolean  @default(false) // true when the source listed no department (named after its programme)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  programs Program[]
  courses  DepartmentCourse[]

  @@unique([facultyId, name])
  @@map("academic_departments")
}

model Program {
  id           String             @id
  departmentId String
  department   AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  status       String             @default("approved") // approved | pending
  duration     String?
  award        String?
  utmeSubjects String?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  curricula ProgramCurriculum[]

  @@unique([departmentId, name])
  @@map("programs")
}

// ─── Study groups ─────────────────────────────────────────────────────────────

model StudyGroup {
  id                 String       @id @default(uuid())
  code               String       @unique // public invite code, e.g. Ab7KxP9q
  name               String
  description        String?
  iconUrl            String?
  createdById        String
  createdBy          User         @relation("StudyGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvalRequired   Boolean      @default(true)
  maxMembers         Int          @default(200)
  memberCount        Int          @default(1)
  // Course-rep / departmental groups
  official           Boolean      @default(false)
  institutionId      String?
  institution        Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  scopeType          String       @default("open") // open | faculty | department | program | course | level
  faculty            String?
  department         String?
  program            String?
  courseCode         String?
  level              String?
  // Activity
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastMessageSender  String?
  lastMessageType    String?
  lastScopeInviteAt  DateTime?
  archived           Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  members  StudyGroupMember[]
  messages StudyGroupMessage[]

  @@index([createdById])
  @@index([institutionId, program, level])
  @@map("study_groups")
}

model StudyGroupMember {
  id                 String     @id @default(uuid())
  groupId            String
  group              StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId             String
  user               User       @relation("StudyGroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role               String     @default("member") // creator | moderator | member
  status             String     @default("pending") // pending | active | rejected | left | removed
  requestedAt        DateTime   @default(now())
  joinedAt           DateTime?
  reviewedById       String?
  reviewedAt         DateTime?
  lastReadAt         DateTime?
  // Older-message access for members who joined later
  historyAccess      String     @default("none") // none | pending | granted | rejected
  historyRequestedAt DateTime?
  historyReviewedAt  DateTime?
  historyReviewedBy  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status])
  @@index([groupId, historyAccess])
  @@map("study_group_members")
}

model StudyGroupMessage {
  id                 String     @id @default(uuid())
  groupId            String
  group              StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId           String?
  sender             User?      @relation("StudyGroupMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  type               String     @default("text") // text | image | video | document | system
  text               String?
  attachmentUrl      String?
  attachmentName     String?
  attachmentMime     String?
  attachmentBytes    Int?
  attachmentWidth    Int?
  attachmentHeight   Int?
  attachmentDuration Int?
  thumbnailUrl       String?
  archive            Json? // text + attachment kept on delete so staff can restore it
  clientId           String? // client-generated id, makes retries idempotent
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime   @default(now())

  @@unique([groupId, clientId])
  @@index([groupId, createdAt])
  @@map("study_group_messages")
}

// ── Academicall Vault ─────────────────────────────────────────────────────────
// PIN-locked private storage. File bytes are AES-256-GCM encrypted at rest.
model VaultAccount {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash           String
  pinSetAt          DateTime  @default(now())
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  recoveryHash      String?
  recoveryExpiresAt DateTime?
  recoverySentAt    DateTime?
  recoveryAttempts  Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("vault_accounts")
}

model VaultFolder {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String      @default("violet")
  deletedAt    DateTime?
  originalName String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  files        VaultFile[]

  @@unique([userId, name])
  @@index([userId])
  @@map("vault_folders")
}

model VaultFile {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId    String
  folder      VaultFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name        String
  kind        String // image | pdf
  mimeType    String
  size        Int
  iv          Bytes
  authTag     Bytes
  data        Bytes
  deletedAt   DateTime? // in the user's trash for 30 days; admins can restore
  deletedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([folderId, createdAt])
  @@map("vault_files")
}

// ── Academicall News ──────────────────────────────────────────────────────────
model NewsPost {
  id             String         @id @default(uuid())
  slug           String         @unique
  title          String
  excerpt        String?
  body           String
  coverUrl       String?
  category       String         @default("Campus")
  status         String         @default("draft") // draft | review | published | hidden
  /// Topic tags readers can subscribe to
  tags           String[]       @default([])
  /// Who the publisher aimed it at: { groups: ["students","aspirants","staff"], institutionIds: [], levels: [] }.
  /// Everyone still sees it on the news page; the audience gets it first.
  audience       Json?
  moderationNote String?
  moderatedById  String?
  moderatedAt    DateTime?
  authorId       String?
  author         User?          @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  viewCount      Int            @default(0)
  commentCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  comments       NewsComment[]
  reactions      NewsReaction[]

  @@index([status, publishedAt])
  @@index([category])
  @@map("news_posts")
}

model NewsComment {
  id        String    @id @default(uuid())
  postId    String
  post      NewsPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@map("news_comments")
}

model NewsReaction {
  postId    String
  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // like | love | fire | clap | wow
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([postId, type])
  @@map("news_reactions")
}

/// Secretariat register: memos, minutes, letters, reports and circulars,
/// kept by anyone holding the "secretary" duty (and admins).
model SecretariatRecord {
  id            String    @id @default(uuid())
  refNo         String    @unique // ACA/SEC/2026/0001
  kind          String    @default("memo") // memo | minutes | letter | report | circular | notice | other
  title         String
  summary       String?
  body          String    @default("")
  status        String    @default("draft") // draft | filed | archived
  confidential  Boolean   @default(false)
  tags          String[]  @default([])
  attachments   Json? // [{ name, url, mime, size }]
  meetingDate   DateTime?
  createdById   String?
  createdBy     User?     @relation("SecretariatAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByName String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([kind, status])
  @@index([createdAt])
  @@map("secretariat_records")
}

/// A national course list (NUC CCMAS/BMAS, NBTE, NCCE) — one per programme heading in the source document.
model Curriculum {
  id               String   @id
  name             String
  tier             String // degree | nd | nce
  edition          String?
  legacyEdition    String?
  /// Applies to every programme of its tier at the listed institutions (GNS, GSE, EDU)
  general          Boolean  @default(false)
  aliases          String[] @default([])
  institutionAbbrs String[] @default([])
  source           String   @default("national") // national | admin
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entries  CurriculumCourse[]
  programs ProgramCurriculum[]

  @@index([tier])
  @@map("curricula")
}

model CurriculumCourse {
  id           String     @id @default(uuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level        String
  semester     String?
  units        Int?
  status       String?
  /// From the older curriculum (NUC BMAS), kept for students on the previous scheme
  legacy       Boolean    @default(false)

  @@unique([curriculumId, courseId, level, legacy])
  @@index([courseId])
  @@map("curriculum_courses")
}

model ProgramCurriculum {
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  /// jamb (institution + programme name) | name (programme name only) | general | admin
  matchedBy    String     @default("jamb")
  createdAt    DateTime   @default(now())

  @@id([programId, curriculumId])
  @@index([curriculumId])
  @@map("program_curricula")
}

/// A course an admin attached to one department (institution-specific courses, electives, corrections).
model DepartmentCourse {
  id           String             @id @default(uuid())
  departmentId String
  department   AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level        String?
  semester     String?
  status       String?
  createdById  String?
  createdAt    DateTime           @default(now())

  @@unique([departmentId, courseId])
  @@index([courseId])
  @@map("department_courses")
}

// ── Aspirants ─────────────────────────────────────────────────────────────────
/// An aspirant's institution of choice: rank 1 (first choice, required) or 2 (second, optional).
model Aspiration {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank          Int // 1 | 2
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course        String? // the course they hope to study there
  programId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, rank])
  @@unique([userId, institutionId])
  @@index([institutionId])
  @@map("aspirations")
}

/// One house per institution. Every aspirant who chose that institution is a member.
model AspirantHouse {
  id            String                @id @default(uuid())
  institutionId String                @unique
  institution   Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  motto         String?
  coverUrl      String?
  rules         String?
  memberCount   Int                   @default(0)
  threadCount   Int                   @default(0)
  lastThreadAt  DateTime?
  archived      Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  members       AspirantHouseMember[]
  leaders       AspirantHouseLeader[]
  threads       HouseThread[]

  @@index([memberCount])
  @@map("aspirant_houses")
}

model AspirantHouseMember {
  id         String        @id @default(uuid())
  houseId    String
  house      AspirantHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  choiceRank Int? // 1 or 2
  status     String        @default("active") // active | muted | removed
  reason     String?
  statusById String?
  joinedAt   DateTime      @default(now())
  lastReadAt DateTime?
  updatedAt  DateTime      @updatedAt

  @@unique([houseId, userId])
  @@index([userId, status])
  @@index([houseId, status])
  @@map("aspirant_house_members")
}

/// House Leaders: people the admin picked (students or agents) to run a house.
model AspirantHouseLeader {
  houseId      String
  house        AspirantHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  createdAt    DateTime      @default(now())

  @@id([houseId, userId])
  @@index([userId])
  @@map("aspirant_house_leaders")
}

/// Only House Leaders start threads. Members reply.
model HouseThread {
  id          String        @id @default(uuid())
  houseId     String
  house       AspirantHouse @relation(fields: [houseId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?         @relation("HouseThreadAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title       String
  body        String
  imageUrl    String?
  mentions    String[]      @default([])
  pinned      Boolean       @default(false)
  pinnedAt    DateTime?
  locked      Boolean       @default(false)
  replyCount  Int           @default(0)
  lastReplyAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  replies     HouseReply[]

  @@index([houseId, pinned, createdAt])
  @@map("house_threads")
}

model HouseReply {
  id          String      @id @default(uuid())
  threadId    String
  thread      HouseThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?       @relation("HouseReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  imageUrl    String?
  mentions    String[]    @default([])
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime    @default(now())

  @@index([threadId, createdAt])
  @@map("house_replies")
}

// ── Student dashboard board ───────────────────────────────────────────────────
/// Slides on the student dashboard, curated by admins and agents with "board.manage".
/// kind "message" shows text over a background; kind "image" is a full-bleed design with no text.
model DashboardSlide {
  id            String    @id @default(uuid())
  kind          String    @default("message") // message | image
  title         String?
  body          String?
  imageUrl      String?
  ctaLabel      String?
  ctaUrl        String?
  theme         String    @default("midnight") // midnight | violet | lemon | aqua
  audience      String    @default("students") // students | aspirants | all
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, sortOrder])
  @@map("dashboard_slides")
}

// ── News subscriptions ────────────────────────────────────────────────────────
/// kind: category | topic | author | institution. New stories that match are delivered as they drop.
model NewsSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  value     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, value])
  @@index([kind, value])
  @@map("news_subscriptions")
}

// ── UTME CBT practice ────────────────────────────────────────────────────────
/// One finished UTME CBT practice session. The question bank itself is static
/// (public/utme/*.json in the web app); this keeps each candidate's history.
model UtmeAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "topic" | "year" | "mixed"
  mode        String
  /// "exam" (timed, answers at the end) | "practice" (instant feedback)
  style       String
  /// [{ slug, name, total, correct, score }]
  subjects    Json
  /// The setup the candidate picked: topics, years, question counts, time limit
  config      Json
  /// Compact answers: { "<slug>:<qid>": optionIndex }
  answers     Json?
  total       Int
  correct     Int
  /// Scaled like JAMB: each subject out of 100, so four subjects make 400
  score       Int
  maxScore    Int
  durationSec Int
  timeLimitSec Int?
  /// { "<slug>": { "<topic>": [answered, correct] } } — feeds progress coaching
  topicStats  Json?
  /// ["<slug>:<qid>", …] questions answered wrongly — feeds the control room's most-missed list
  missed      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("utme_attempts")
}

/// UTME bank changes made in the control room. The shipped bank (public/utme)
/// stays untouched; the app layers these on top when it loads a subject.
model UtmeQuestionPatch {
  id          String   @id @default(uuid())
  /// subject slug, e.g. "biology"
  slug        String
  /// question id in the shipped bank ("3-148"), or "x-…" for questions added here
  qid         String
  /// "edited" | "added" | "removed"
  status      String
  /// true when the question was added in the control room (not in the shipped bank)
  isNew       Boolean  @default(false)
  /// question in bank format (s, si, o, oi, a, e, y, t/tn, p/pt/ph); null for a plain removal
  data        Json?
  note        String?
  updatedById String?
  updatedBy   User?    @relation("UtmePatchEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, qid])
  @@index([updatedAt])
  @@map("utme_question_patches")
}

/// Pictures uploaded for UTME questions (watermarked WebP).
model UtmeMedia {
  id          String   @id @default(uuid())
  slug        String?
  mime        String   @default("image/webp")
  width       Int
  height      Int
  bytes       Bytes
  createdById String?
  createdAt   DateTime @default(now())

  @@map("utme_media")
}

// ── Safety & moderation ──────────────────────────────────────────────────────
/// Something a user reported: a group message, house thread or reply, news comment, feed post or a person.
model ContentReport {
  id           String    @id @default(uuid())
  reporterId   String?
  /// group_message | house_thread | house_reply | news_comment | feed_post | user
  targetType   String
  targetId     String
  /// The author of the reported content (or the reported person)
  targetUserId String?
  /// spam | abuse | harassment | sexual | violence | false_info | cheating | other
  reason       String
  note         String?
  /// Copy of the content at report time, so staff see it even if it's edited or removed
  snapshot     Json?
  /// Where in the app it lives, e.g. /study/BIO101
  contextUrl   String?
  /// open | actioned | dismissed
  status       String    @default("open")
  /// hide | warn | mute | dismiss
  action       String?
  actionNote   String?
  handledById  String?
  handledByName String?
  handledAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@map("content_reports")
}

model UserBlock {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// Warnings and mutes issued from the moderation queue.
model UserRestriction {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// warn | mute
  kind          String
  reason        String?
  reportId      String?
  until         DateTime?
  createdById   String?
  createdByName String?
  liftedAt      DateTime?
  liftedById    String?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("user_restrictions")
}

// ── Sign-in security ─────────────────────────────────────────────────────────
/// One signed-in device. Tokens carry its id, so signing a device out revokes its token.
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip          String?
  userAgent   String?
  /// web | android | ios
  platform    String?
  /// password | google
  method      String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  ip        String?
  userAgent String?
  /// password | google
  method    String?
  /// success | bad_password | inactive | code_sent | code_failed | code_passed
  outcome   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

/// Short-lived two-step sign-in challenge (email code or authenticator check).
model AuthChallenge {
  id        String    @id @default(uuid())
  userId    String
  /// login | setup_email | disable
  kind      String
  codeHash  String?
  attempts  Int       @default(0)
  meta      Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@map("auth_challenges")
}

// ── Push notifications ───────────────────────────────────────────────────────
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  /// android | ios | web
  platform   String
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// ── UTME question reports ────────────────────────────────────────────────────
model UtmeQuestionReport {
  id           String    @id @default(uuid())
  slug         String
  qid          String
  /// wrong_answer | typo | missing_image | unclear | wrong_topic | other
  reason       String
  note         String?
  userId       String?
  userName     String?
  /// open | fixed | dismissed
  status       String    @default("open")
  resolution   String?
  resolvedById String?
  resolvedByName String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, slug])
  @@index([slug, qid])
  @@map("utme_question_reports")
}

// ── CGPA ─────────────────────────────────────────────────────────────────────
model AcademicResult {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "2025/2026"
  session     String
  /// first | second | third
  semester    String
  courseCode  String
  courseTitle String?
  units       Int
  /// A | B | C | D | E | F
  grade       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, session, semester])
  @@map("academic_results")
}

// ── Data requests & backups ──────────────────────────────────────────────────
model DataRequest {
  id            String    @id @default(uuid())
  userId        String?
  userEmail     String?
  userName      String?
  /// export | delete
  kind          String
  /// pending | done | rejected | cancelled
  status        String    @default("pending")
  /// self | staff
  source        String    @default("self")
  note          String?
  handledById   String?
  handledByName String?
  handledAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@map("data_requests")
}

model BackupRun {
  id          String    @id @default(uuid())
  /// running | ok | failed
  status      String
  /// manual | scheduled | external
  kind        String    @default("scheduled")
  sizeBytes   BigInt?
  location    String?
  note        String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdById String?

  @@index([startedAt])
  @@map("backup_runs")
}

// ── General tests (set by staff, aimed at chosen students or aspirants) ──────
model GeneralTest {
  id            String    @id @default(uuid())
  title         String
  instructions  String?
  /// [{ key, name, subject?, count }]
  sections      Json
  /// Frozen question set with answers: [{ key, section, s, o, a, e, … }]. Never sent to candidates with answers.
  questions     Json
  questionCount Int       @default(0)
  durationMin   Int       @default(30)
  opensAt       DateTime?
  closesAt      DateTime?
  /// { roles: ["student","aspirant"], institutionIds, facultyIds, departmentIds, programIds, levels, houseIds, choiceInstitutionIds, utmeYears, plans, userIds }
  audience      Json
  audienceCount Int       @default(0)
  /// instant | after_close | hidden
  showResults   String    @default("instant")
  shuffle       Boolean   @default(true)
  maxAttempts   Int       @default(1)
  /// draft | published | closed | archived
  status        String    @default("draft")
  createdById   String?
  createdByName String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  attempts      GeneralTestAttempt[]

  @@index([status, opensAt])
  @@map("general_tests")
}

model GeneralTestAttempt {
  id            String      @id @default(uuid())
  testId        String
  test          GeneralTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNo     Int         @default(1)
  /// in_progress | submitted
  status        String      @default("in_progress")
  /// question keys in the order this candidate sees them
  order         Json
  /// { "<key>": optionIndex }
  answers       Json?
  startedAt     DateTime    @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?
  total         Int         @default(0)
  correct       Int?
  /// percentage 0–100
  score         Int?
  /// [{ key, name, total, correct }]
  sectionScores Json?

  @@unique([testId, userId, attemptNo])
  @@index([testId, status])
  @@index([userId])
  @@map("general_test_attempts")
}
