# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Docker Compose default)
DATABASE_URL="postgresql://academicall:academicall_secret@localhost:5432/academicall?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Google Identity Services (Firebase-free Google sign-in).
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Set this to the same client ID used by the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# CORS (comma separated origins). Leave empty during local debugging to allow all.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Production example:
# CORS_ORIGIN=https://your-frontend.example.com

# Brevo transactional email (password reset + verification codes)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@academicall.site
BREVO_SENDER_NAME=Academicall
BREVO_REPLY_TO_EMAIL=noreply@academicall.site
FRONTEND_URL=http://localhost:5173

# Paystack webhook (POST https://<api-domain>/api/v1/payments/webhook/paystack)
# Set this in your Paystack dashboard as the webhook secret / signing key.
PAYSTACK_SECRET_KEY=

# Study groups and institution catalogue
PUBLIC_APP_URL=https://academicall.site
CLOUDINARY_CLOUD_NAME=
GROUP_MAX_IMAGE_MB=10
GROUP_MAX_VIDEO_MB=25
GROUP_MAX_DOCUMENT_MB=20
GROUP_MAX_VIDEO_SECONDS=180
AUTO_SEED_INSTITUTIONS=true
