# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Docker Compose default)
DATABASE_URL="postgresql://academicall:academicall_secret@localhost:5432/academicall?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Firebase Admin (for hybrid auth – optional for pure JWT testing)
# Download service account JSON from Firebase Console → Project Settings → Service accounts
# Then either set the path or paste the JSON content into FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# CORS (comma separated origins, or * for dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@academicall.site
BREVO_SENDER_NAME=Academicall
BREVO_REPLY_TO_EMAIL=noreply@academicall.site

# Production: set this to the deployed frontend origin, for example
# https://your-app.web.app or https://your-app.up.railway.app
# CORS_ORIGIN=https://your-frontend.example.com
DATABASE_URL="postgresql://academicall:academicall_secret@localhost:5432/academicall?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000